// =====================================================================
// Regras de segurança do Firestore — Eagles Labz (multi-tenant)
// =====================================================================
//
// COMO USAR:
// 1. No Console do Firebase, vá em Firestore Database → Regras.
// 2. Apague o que estiver lá e cole este arquivo inteiro.
// 3. Clique em "Publicar".
//
// O QUE ESSAS REGRAS GARANTEM:
// - Cada empresa (tenant) só enxerga e só grava os PRÓPRIOS dados.
// - O papel (role) de cada usuário mora no documento usuarios/{uid} —
//   não existe como "custom claim" do Firebase Auth porque isso só pode
//   ser configurado a partir de um servidor (Admin SDK / Cloud Functions),
//   que este projeto (só front-end estático) não usa.
// - Super Admin enxerga tudo, em qualquer empresa.
// - Um usuário comum (TenantUser) só lê os próprios dados de perfil, não
//   consegue criar nem remover outros usuários.
// - Um TenantAdmin só cria/gerencia usuários dentro da PRÓPRIA empresa.
//
// Agenda: coleção agenda.
//
// Portal do Cliente: papel 'Cliente' + coleções portal e portal_pedidos.
//
// Conteúdos: coleções conteudos e conteudos_publicos.
//
// Página Pública: coleções paginas_publicas e leads_publicos.
//
// Financeiro novo: coleções fin_lancamentos, fin_recorrencias e fin_meta.
//
// 02/10/2026 (Serviços): nova coleção pública planos_publicos.
//
// 02/10/2026 (Níveis de acesso): cada empresa tem um limite de usuários
//   (vagas) e 3 níveis — Diretor (tudo), Administrativo (tudo menos o
//   financeiro) e Financeiro (financeiro + só visualizar o resto). Os
//   papéis antigos TenantAdmin/TenantUser valem como Diretor.
//
// 02/10/2026 (Kanban): novas coleções tenants/{id}/kanban_tarefas e
//   tenants/{id}/kanban_projetos.
//
// REVISÃO DE SEGURANÇA (02/10/2026) — o que mudou:
// - Ninguém consegue mais mudar o PRÓPRIO papel (role) ou a própria
//   empresa (tenantId). Antes, um usuário comum podia se promover a
//   SuperAdmin pelo console do navegador.
// - Um TenantAdmin só cria/edita usuários como TenantAdmin ou TenantUser
//   (nunca SuperAdmin) e não consegue mover alguém pra outra empresa.
// - O documento da empresa (tenants/{id}: plano, ativo, nome) agora só é
//   gravado pelo Super Admin. Antes, qualquer membro podia trocar o
//   próprio plano ou se reativar.
// - Empresa desativada (ativo == false) perde o acesso aos dados de
//   verdade, não só na tela.
// - propostas_publicas e briefings_publicos: o link continua abrindo
//   SEM login (leitura de UM documento pelo id), mas LISTAR a coleção
//   agora só é permitido pro dono. Antes, qualquer pessoa conseguia
//   listar as propostas e os briefings de TODAS as empresas.
//
// LIMITAÇÃO CONHECIDA: o limite de 5 usuários por empresa é aplicado no
// aplicativo (JavaScript), não aqui nas regras — bloquear isso também no
// servidor exigiria contar documentos numa regra (o Firestore não faz
// isso de forma simples sem Cloud Functions ou um contador mantido à
// parte). Na prática, isso significa que o limite é confiável para uso
// normal do sistema, mas não é uma trava 100% à prova de um usuário
// tecnicamente malicioso tentando burlar a interface.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function meuUsuarioDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function meuTenantId() {
      return meuUsuarioDoc().get('tenantId', null);
    }

    function meuRole() {
      return meuUsuarioDoc().get('role', 'TenantUser');
    }

    function souSuperAdmin() {
      return estaLogado() && meuRole() == 'SuperAdmin';
    }

    // Níveis da empresa. Papéis antigos (TenantAdmin/TenantUser) = Diretor.
    function ehRoleDiretor(role) {
      return role == 'Diretor' || role == 'TenantAdmin' || role == 'TenantUser';
    }
    function souDiretor() {
      return estaLogado() && (meuRole() == 'SuperAdmin' || ehRoleDiretor(meuRole()));
    }
    // Vê e mexe no financeiro (caixa, despesas, lucro, metas)
    function veFinanceiro() {
      return estaLogado() && (meuRole() == 'SuperAdmin' || ehRoleDiretor(meuRole()) || meuRole() == 'Financeiro');
    }
    // Cadastra e edita o operacional (clientes, pedidos, CRM, Kanban...)
    function podeOperar() {
      return estaLogado() && (meuRole() == 'SuperAdmin' || ehRoleDiretor(meuRole()) || meuRole() == 'Administrativo');
    }

    // Login do Portal do Cliente: NÃO é da equipe. Só vê o que é do
    // cliente dele (clienteNome) e só faz o que as regras abaixo liberam.
    function souCliente(tenantId) {
      return estaLogado() && meuRole() == 'Cliente' && meuTenantId() == tenantId && empresaAtiva(tenantId);
    }
    function meuClienteNome() {
      return meuUsuarioDoc().get('clienteNome', '');
    }

    // Níveis que um Diretor pode dar (nunca SuperAdmin).
    function roleNovo(role) {
      return role == 'Diretor' || role == 'Administrativo' || role == 'Financeiro';
    }
    // Inclui os papéis antigos (pra editar/remover quem já existia)
    function roleDeEmpresa(role) {
      return roleNovo(role) || role == 'TenantAdmin' || role == 'TenantUser';
    }

    // Limite de usuários: cada usuário ocupa uma "vaga" numerada
    // (tenants/{id}/vagas/{1..limite}). Empresa sem limite definido
    // (criada antes desse recurso) não exige vaga.
    function vagaValida(tenantId, uid) {
      let t = get(/databases/$(database)/documents/tenants/$(tenantId)).data;
      return !('limiteUsuarios' in t) || (
        request.resource.data.vaga is int &&
        request.resource.data.vaga >= 1 &&
        request.resource.data.vaga <= t.limiteUsuarios &&
        existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/vagas/$(string(request.resource.data.vaga))) &&
        getAfter(/databases/$(database)/documents/tenants/$(tenantId)/vagas/$(string(request.resource.data.vaga))).data.uid == uid
      );
    }

    // A empresa existe e não foi desativada pelo Super Admin.
    // (empresa sem o campo "ativo" = criada antes desse recurso = ativa)
    function empresaAtiva(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('ativo', true) != false;
    }

    // Sou membro dessa empresa e ela está ativa.
    function souMembroAtivo(tenantId) {
      return estaLogado() && meuTenantId() != null && meuTenantId() == tenantId && meuRole() != 'Cliente' && empresaAtiva(tenantId);
    }

    // ---------- usuarios/{uid} ----------
    match /usuarios/{userId} {
      // Cada um lê o próprio documento (é assim que o sistema descobre o
      // tenantId e o papel logo após o login). Colegas da mesma empresa
      // também (a tela de Usuários lista a equipe).
      allow read: if estaLogado() && (
        request.auth.uid == userId ||
        souSuperAdmin() ||
        (resource.data.get('tenantId', null) != null && meuTenantId() == resource.data.get('tenantId', null) && meuRole() != 'Cliente')
      );

      // Super Admin cria qualquer usuário. Diretor só cria na própria
      // empresa, num nível de empresa, numa vaga livre do limite e nunca
      // como titular (titular é definido só pelo Super Admin).
      allow create: if estaLogado() && (
        souSuperAdmin() ||
        (souDiretor() &&
          request.resource.data.tenantId == meuTenantId() &&
          empresaAtiva(meuTenantId()) &&
          roleNovo(request.resource.data.role) &&
          request.resource.data.get('titular', false) == false &&
          vagaValida(meuTenantId(), userId)) ||
        // login de cliente do portal: quem opera cria, sem vaga (não conta no limite)
        (podeOperar() &&
          request.resource.data.tenantId == meuTenantId() &&
          empresaAtiva(meuTenantId()) &&
          request.resource.data.role == 'Cliente' &&
          request.resource.data.clienteNome is string && request.resource.data.clienteNome.size() > 0 &&
          request.resource.data.get('titular', false) == false &&
          !('vaga' in request.resource.data))
      );

      allow update: if estaLogado() && (
        souSuperAdmin() ||
        // o próprio usuário: pode mudar o nome etc., NUNCA nível, empresa,
        // titularidade ou vaga
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'tenantId', 'titular', 'vaga', 'clienteNome'])) ||
        (podeOperar() && resource.data.role == 'Cliente' &&
          resource.data.tenantId == meuTenantId() && request.resource.data.tenantId == meuTenantId() &&
          request.resource.data.role == 'Cliente' && !('vaga' in request.resource.data)) ||
        // Diretor: só gente da própria empresa, que continua nela, num nível
        // de empresa — e nunca mexe no titular
        (souDiretor() &&
          resource.data.tenantId == meuTenantId() &&
          request.resource.data.tenantId == meuTenantId() &&
          resource.data.get('titular', false) == false &&
          roleNovo(request.resource.data.role) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['titular', 'vaga']))
      );

      // Remover acesso: Diretor da empresa, nunca o titular.
      allow delete: if estaLogado() && (
        souSuperAdmin() ||
        (souDiretor() &&
          resource.data.tenantId == meuTenantId() &&
          resource.data.get('titular', false) == false &&
          roleDeEmpresa(resource.data.role)) ||
        (podeOperar() && resource.data.tenantId == meuTenantId() && resource.data.role == 'Cliente')
      );
    }

    // ---------- tenants/{tenantId} ----------
    // Dados gerais da empresa (nome, plano, ativo). Membros LEEM (o app
    // precisa saber o plano); só o Super Admin GRAVA.
    match /tenants/{tenantId} {
      allow read: if estaLogado() && (souSuperAdmin() || meuTenantId() == tenantId);
      allow write: if souSuperAdmin();

      // ---------- tenants/{tenantId}/dados/{docId} ----------
      // TODOS os dados operacionais da empresa (clientes, produtos,
      // pedidos, financeiro, CRM, configurações...). Só membros de uma
      // empresa ATIVA (ou o Super Admin) leem e gravam.
      // Por nível: o financeiro (caixa, modelo, metas) só pra quem vê
      // financeiro; configurações da empresa só o Diretor grava; o resto
      // todos leem e só quem opera grava.
      match /dados/{docId} {
        allow read: if souSuperAdmin() || (souMembroAtivo(tenantId) &&
          (!(docId in ['eagles_fin_ciclos_v1', 'eagles_fin_modelo_v1', 'eagles_fin_metas_v1', 'eagles_fin_caixas_v1', 'eagles_fin_tributos_v1', 'eagles_fin_pix_v1']) || veFinanceiro()));
        allow write: if souSuperAdmin() || (souMembroAtivo(tenantId) && (
          (docId in ['eagles_fin_ciclos_v1', 'eagles_fin_modelo_v1', 'eagles_fin_metas_v1', 'eagles_fin_caixas_v1', 'eagles_fin_tributos_v1', 'eagles_fin_pix_v1'] && veFinanceiro()) ||
          (docId in ['eagles_perfil_empresa_v1', 'eagles_cfg_portal_cliente_v1', 'eagles_cfg_briefing_visual_v1', 'eagles_cfg_categorias_conteudo_v1', 'eagles_crm_pagina_aprovacao_v1', 'eagles_integracao_pixels_v1', 'eagles_backup_meta_v1'] && souDiretor()) ||
          (!(docId in ['eagles_fin_ciclos_v1', 'eagles_fin_modelo_v1', 'eagles_fin_metas_v1', 'eagles_fin_caixas_v1', 'eagles_fin_tributos_v1', 'eagles_fin_pix_v1', 'eagles_perfil_empresa_v1', 'eagles_cfg_portal_cliente_v1', 'eagles_cfg_briefing_visual_v1', 'eagles_cfg_categorias_conteudo_v1', 'eagles_crm_pagina_aprovacao_v1', 'eagles_integracao_pixels_v1', 'eagles_backup_meta_v1']) && podeOperar())
        ));
      }

      // Vagas do limite de usuários: o Diretor ocupa uma vaga junto com a
      // criação do usuário (mesmo lote) e libera junto com a remoção.
      match /vagas/{vagaId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId);
        allow create: if souSuperAdmin() || (
          souDiretor() && meuTenantId() == tenantId && empresaAtiva(tenantId) &&
          int(vagaId) >= 1 &&
          int(vagaId) <= get(/databases/$(database)/documents/tenants/$(tenantId)).data.limiteUsuarios &&
          request.resource.data.uid is string &&
          getAfter(/databases/$(database)/documents/usuarios/$(request.resource.data.uid)).data.tenantId == tenantId
        );
        allow update: if souSuperAdmin();
        allow delete: if souSuperAdmin() || (
          souDiretor() && meuTenantId() == tenantId &&
          !existsAfter(/databases/$(database)/documents/usuarios/$(resource.data.uid))
        );
      }

      // ---------- Financeiro (modelo novo) ----------
      // Um documento por lançamento / recorrência. Quem opera (ex.:
      // Administrativo fechando um negócio ou fazendo uma venda) pode
      // CRIAR; ler, editar e excluir é só de quem vê o financeiro.
      match /fin_lancamentos/{id} {
        allow read, update, delete: if souSuperAdmin() || (souMembroAtivo(tenantId) && veFinanceiro());
        allow create: if souSuperAdmin() || (souMembroAtivo(tenantId) && (veFinanceiro() || podeOperar()));
      }
      match /fin_recorrencias/{id} {
        allow read, update, delete: if souSuperAdmin() || (souMembroAtivo(tenantId) && veFinanceiro());
        allow create: if souSuperAdmin() || (souMembroAtivo(tenantId) && (veFinanceiro() || podeOperar()));
      }
      match /fin_meta/{id} {
        allow read, write: if souSuperAdmin() || (souMembroAtivo(tenantId) && veFinanceiro());
      }

      // Receitas lançadas por quem NÃO vê o financeiro (ex.: Administrativo
      // fechando um negócio). Ele só consegue CRIAR aqui — nunca ler o
      // caixa. Quem vê o financeiro move essas receitas pro mês certo.
      match /receitas_pendentes/{id} {
        allow create: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
        allow read, delete: if souSuperAdmin() || (souMembroAtivo(tenantId) && veFinanceiro());
      }

      // ---------- tenants/{tenantId}/kanban_tarefas/{tarefaId} ----------
      // Kanban do CRM: UMA tarefa por documento (pra equipe editar o
      // quadro ao mesmo tempo sem uma gravação apagar a outra). Mesma
      // proteção dos dados: só membros de empresa ativa (ou Super Admin).
      // Conteúdos (produção): um documento por conteúdo
      match /conteudos/{conteudoId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId) ||
          (souCliente(tenantId) && resource.data.cliente == meuClienteNome());
        allow write: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
        // cliente no portal: só responde (aprovar/ajustes) e marca como postado
        allow update: if souCliente(tenantId) && resource.data.cliente == meuClienteNome() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['portalResposta', 'portalComentario', 'portalRespondidoEm', 'portalPostadoEm', 'portalPendente']) &&
          request.resource.data.get('portalComentario', '') is string && request.resource.data.get('portalComentario', '').size() <= 1000;
      }

      // Agenda: um documento por compromisso
      match /agenda/{compromissoId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId);
        allow write: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
      }

      // Portal do Cliente: padrão da agência (_padrao) e ajustes de cada cliente
      match /portal/{docId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId) ||
          (souCliente(tenantId) && (docId == '_padrao' || resource.data.cliente == meuClienteNome()));
        allow write: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
      }

      // Pedidos do portal (ideias de post e serviços)
      match /portal_pedidos/{pedidoId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId) ||
          (souCliente(tenantId) && resource.data.cliente == meuClienteNome());
        allow create: if souCliente(tenantId) &&
          request.resource.data.keys().hasOnly(['cliente', 'tipo', 'titulo', 'texto', 'links', 'prazo', 'criadoEm', 'processado', 'autorUid']) &&
          request.resource.data.cliente == meuClienteNome() && request.resource.data.processado == false &&
          request.resource.data.autorUid == request.auth.uid &&
          request.resource.data.tipo in ['ideia', 'servico'] &&
          request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 100 &&
          request.resource.data.texto is string && request.resource.data.texto.size() <= 2000 &&
          request.resource.data.links is list && request.resource.data.links.size() <= 10;
        allow update, delete: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
        allow create: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar()); // restaurar backup
      }

      match /kanban_tarefas/{tarefaId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId);
        allow write: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
      }

      // Projetos do Kanban: também um documento por projeto.
      match /kanban_projetos/{projetoId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId);
        allow write: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
      }
    }

    // ---------- propostas_publicas/{propostaId} ----------
    // Exceção controlada: o cliente final abre a proposta por um link,
    // sem login.
    // - "get" (abrir UM documento pelo id do link): público, desde que não
    //   seja rascunho.
    // - "list" (consultar a coleção): só o dono, filtrando pela própria
    //   empresa. Sem isso, qualquer um listaria propostas de todo mundo.
    // - Quem não é dono só consegue marcar como visualizada, aprovar (com
    //   assinatura) ou recusar — nenhum outro campo.
    match /propostas_publicas/{propostaId} {
      allow get: if resource.data.status != 'rascunho' ||
        (estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId()));

      allow list: if estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId());

      allow create: if estaLogado() && request.resource.data.tenantId == meuTenantId() && empresaAtiva(meuTenantId()) && podeOperar();

      allow update: if
        (estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()))) ||
        (
          resource.data.status == 'enviada' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assinatura', 'atualizadoEm', 'visualizadoEm']) &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visualizadoEm']) ||
            request.resource.data.status == 'aprovada' ||
            request.resource.data.status == 'recusada'
          )
        );

      allow delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
    }

    // ---------- paginas_publicas/{endereco} ----------
    // Site da empresa (Página Pública). Mesma lógica dos planos: o visitante
    // lê UM documento pelo endereço (se ativo); o endereço é o id, então
    // duas empresas nunca usam o mesmo.
    match /paginas_publicas/{endereco} {
      allow get: if resource.data.ativa == true ||
        (estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId()));
      allow list: if estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId());
      allow create: if estaLogado() && request.resource.data.tenantId == meuTenantId() && empresaAtiva(meuTenantId()) && podeOperar();
      allow update: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && (podeOperar() || souDiretor()))) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
    }

    // ---------- leads_publicos/{id} ----------
    // Formulário de contato do site: o VISITANTE (sem login) só consegue
    // criar, com campos limitados, e só pra uma página publicada e ativa
    // daquela empresa. Quem opera no CRM lê e apaga (vira cliente + negócio).
    match /leads_publicos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tenantId', 'pagina', 'nome', 'email', 'telefone', 'mensagem', 'servicos', 'criadoEm']) &&
        request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 100 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 120 &&
        request.resource.data.telefone is string && request.resource.data.telefone.size() <= 30 &&
        request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 1000 &&
        request.resource.data.servicos is list && request.resource.data.servicos.size() <= 20 &&
        request.resource.data.pagina is string &&
        exists(/databases/$(database)/documents/paginas_publicas/$(request.resource.data.pagina)) &&
        get(/databases/$(database)/documents/paginas_publicas/$(request.resource.data.pagina)).data.ativa == true &&
        get(/databases/$(database)/documents/paginas_publicas/$(request.resource.data.pagina)).data.tenantId == request.resource.data.tenantId;
      allow read, delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
      allow update: if false;
    }

    // ---------- eagles/{chave} (dados de antes das empresas separadas) ----------
    // Só o Super Admin lê, pra ferramenta de importar dados antigos. Ninguém grava.
    match /eagles/{chave} {
      allow read: if souSuperAdmin();
      allow write: if false;
    }

    // ---------- conteudos_publicos/{codigo} ----------
    // Link de aprovação de um conteúdo: o cliente (sem login) lê UM
    // documento pelo código e responde UMA vez — só os campos da resposta.
    match /conteudos_publicos/{codigo} {
      allow get: if true;
      allow list: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
      allow create: if estaLogado() && request.resource.data.tenantId == meuTenantId() && empresaAtiva(meuTenantId()) && podeOperar();
      allow update: if
        (estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar())) && request.resource.data.tenantId == resource.data.tenantId) ||
        (resource.data.resposta == '' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resposta', 'comentario', 'respondidoEm']) &&
          request.resource.data.resposta in ['aprovado', 'ajustes'] &&
          request.resource.data.comentario is string && request.resource.data.comentario.size() <= 1000);
      allow delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
    }

    // ---------- pix_publico/{tenantId} ----------
    // Dados do PIX que o cliente vê na página do orçamento aprovado (chave,
    // nome e cidade — que vão de todo jeito no QR Code). Qualquer um lê
    // UM documento pelo id; só quem vê o financeiro da empresa grava.
    match /pix_publico/{tenantId} {
      allow get: if true;
      allow list: if false;
      allow write: if souSuperAdmin() || (estaLogado() && meuTenantId() == tenantId && empresaAtiva(tenantId) && veFinanceiro());
    }

    // ---------- planos_publicos/{endereco} ----------
    // Apresentação pública de planos: o visitante abre UM documento pelo
    // endereço (só se a página estiver ativa). O id do documento É o
    // endereço, então duas empresas nunca usam o mesmo: a segunda não
    // consegue gravar por cima (o documento já tem dono).
    match /planos_publicos/{endereco} {
      allow get: if resource.data.ativa == true ||
        (estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId()));
      allow list: if estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId());
      allow create: if estaLogado() && request.resource.data.tenantId == meuTenantId() && empresaAtiva(meuTenantId()) && podeOperar();
      allow update: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar())) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
    }

    // ---------- briefings_publicos/{briefingId} ----------
    // Mesma lógica: o cliente final preenche pelo link, sem login.
    // - "get": público (quem tem o link abre).
    // - "list": só o dono, filtrando pela própria empresa.
    // - Quem não é dono só responde, e só enquanto está "pendente".
    match /briefings_publicos/{briefingId} {
      allow get: if true;

      allow list: if estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId());

      allow create: if estaLogado() && request.resource.data.tenantId == meuTenantId() && empresaAtiva(meuTenantId()) && podeOperar();

      allow update: if
        (estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()))) ||
        (
          resource.data.status == 'pendente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respostas', 'respondidoEm']) &&
          request.resource.data.status == 'respondido'
        );

      allow delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
    }
  }
}
