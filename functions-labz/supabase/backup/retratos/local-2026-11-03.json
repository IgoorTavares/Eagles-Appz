      },
      {
        "tabela": "acionamentos",
        "nome": "acionamentos_por",
        "tipo": "c",
        "definicao": "CHECK (((consumido_por IS NULL) OR (char_length(consumido_por) <= 80)))"
      },
      {
        "tabela": "docs",
        "nome": "docs_caminho_valido",
        "tipo": "c",
        "definicao": "CHECK (((caminho ~ '^[^/]+(/[^/]+/[^/]+)*/[^/]+$'::text) AND (char_length(caminho) <= 1500)))"
      },
      {
        "tabela": "docs",
        "nome": "docs_objeto",
        "tipo": "c",
        "definicao": "CHECK ((json_typeof(dados) = 'object'::text))"
      },
      {
        "tabela": "docs",
        "nome": "docs_partes",
        "tipo": "c",
        "definicao": "CHECK ((caminho = ((colecao || '/'::text) || id)))"
      },
      {
        "tabela": "docs",
        "nome": "docs_pkey",
        "tipo": "p",
        "definicao": "PRIMARY KEY (caminho)"
      },
      {
        "tabela": "docs",
        "nome": "docs_tamanho",
        "tipo": "c",
        "definicao": "CHECK ((octet_length((dados)::text) <= 1048576))"
      }
    ],
