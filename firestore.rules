// =====================================================================
// Regras de segurança do Firestore — Eagles Labz (multi-tenant)
// =====================================================================
//
// COMO USAR:
// 1. No Console do Firebase, vá em Firestore Database → Regras.
// 2. Apague o que estiver lá e cole este arquivo inteiro.
// 3. Clique em "Publicar".
//
// O QUE ESSAS REGRAS GARANTEM:
// - Cada empresa (tenant) só enxerga e só grava os PRÓPRIOS dados.
// - O papel (role) de cada usuário mora no documento usuarios/{uid} —
//   não existe como "custom claim" do Firebase Auth porque isso só pode
//   ser configurado a partir de um servidor (Admin SDK / Cloud Functions),
//   que este projeto (só front-end estático) não usa.
// - Super Admin enxerga tudo, em qualquer empresa.
// - Um usuário comum (TenantUser) só lê os próprios dados de perfil, não
//   consegue criar nem remover outros usuários.
// - Um TenantAdmin só cria/gerencia usuários dentro da PRÓPRIA empresa.
//
// Agenda: coleção agenda.
//
// Portal do Cliente: papel 'Cliente' + coleções portal e portal_pedidos.
//
// Conteúdos: coleções conteudos e conteudos_publicos.
//
// Página Pública: coleções paginas_publicas e leads_publicos.
//
// Financeiro novo: coleções fin_lancamentos, fin_recorrencias e fin_meta.
//
// 02/10/2026 (Serviços): nova coleção pública planos_publicos.
//
// 02/10/2026 (Níveis de acesso): cada empresa tem um limite de usuários
//   (vagas) e 3 níveis — Diretor (tudo), Administrativo (tudo menos o
//   financeiro) e Financeiro (financeiro + só visualizar o resto). Os
//   papéis antigos TenantAdmin/TenantUser valem como Diretor.
//
// 02/10/2026 (Kanban): novas coleções tenants/{id}/kanban_tarefas e
//   tenants/{id}/kanban_projetos.
//
// REVISÃO DE SEGURANÇA (02/10/2026) — o que mudou:
// - Ninguém consegue mais mudar o PRÓPRIO papel (role) ou a própria
//   empresa (tenantId). Antes, um usuário comum podia se promover a
//   SuperAdmin pelo console do navegador.
// - Um TenantAdmin só cria/edita usuários como TenantAdmin ou TenantUser
//   (nunca SuperAdmin) e não consegue mover alguém pra outra empresa.
// - O documento da empresa (tenants/{id}: plano, ativo, nome) agora só é
//   gravado pelo Super Admin. Antes, qualquer membro podia trocar o
//   próprio plano ou se reativar.
// - Empresa desativada (ativo == false) perde o acesso aos dados de
//   verdade, não só na tela.
// - propostas_publicas e briefings_publicos: o link continua abrindo
//   SEM login (leitura de UM documento pelo id), mas LISTAR a coleção
//   agora só é permitido pro dono. Antes, qualquer pessoa conseguia
//   listar as propostas e os briefings de TODAS as empresas.
//
// LIMITAÇÃO CONHECIDA: o limite de 5 usuários por empresa é aplicado no
// aplicativo (JavaScript), não aqui nas regras — bloquear isso também no
// servidor exigiria contar documentos numa regra (o Firestore não faz
// isso de forma simples sem Cloud Functions ou um contador mantido à
// parte). Na prática, isso significa que o limite é confiável para uso
// normal do sistema, mas não é uma trava 100% à prova de um usuário
// tecnicamente malicioso tentando burlar a interface.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function meuUsuarioDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function meuTenantId() {
      return meuUsuarioDoc().get('tenantId', null);
    }

    function meuRole() {
      return meuUsuarioDoc().get('role', 'TenantUser');
    }

    function souSuperAdmin() {
      return estaLogado() && meuRole() == 'SuperAdmin';
    }

    // Níveis da empresa. Papéis antigos (TenantAdmin/TenantUser) = Diretor.
    function ehRoleDiretor(role) {
      return role == 'Diretor' || role == 'TenantAdmin' || role == 'TenantUser';
    }
    function souDiretor() {
      return estaLogado() && (meuRole() == 'SuperAdmin' || ehRoleDiretor(meuRole()));
    }
    // Vê e mexe no financeiro (caixa, despesas, lucro, metas)
    function veFinanceiro() {
      return estaLogado() && (meuRole() == 'SuperAdmin' || ehRoleDiretor(meuRole()) || meuRole() == 'Financeiro');
    }
    // Cadastra e edita o operacional (clientes, pedidos, CRM, Kanban...)
    function podeOperar() {
      return estaLogado() && (meuRole() == 'SuperAdmin' || ehRoleDiretor(meuRole()) || meuRole() == 'Administrativo');
    }

    // Login do Portal do Cliente: NÃO é da equipe. Só vê o que é do
    // cliente dele (clienteNome) e só faz o que as regras abaixo liberam.
    function souCliente(tenantId) {
      return estaLogado() && meuRole() == 'Cliente' && meuTenantId() == tenantId && empresaAtiva(tenantId);
    }
    function meuClienteNome() {
      return meuUsuarioDoc().get('clienteNome', '');
    }

    // Níveis que um Diretor pode dar (nunca SuperAdmin).
    function roleNovo(role) {
      return role == 'Diretor' || role == 'Administrativo' || role == 'Financeiro';
    }
    // Inclui os papéis antigos (pra editar/remover quem já existia)
    function roleDeEmpresa(role) {
      return roleNovo(role) || role == 'TenantAdmin' || role == 'TenantUser';
    }

    // Limite de usuários: cada usuário ocupa uma "vaga" numerada
    // (tenants/{id}/vagas/{1..limite}). Empresa sem limite definido
    // (criada antes desse recurso) não exige vaga.
    function vagaValida(tenantId, uid) {
      let t = get(/databases/$(database)/documents/tenants/$(tenantId)).data;
      return !('limiteUsuarios' in t) || (
        request.resource.data.vaga is int &&
        request.resource.data.vaga >= 1 &&
        request.resource.data.vaga <= t.limiteUsuarios &&
        existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/vagas/$(string(request.resource.data.vaga))) &&
        getAfter(/databases/$(database)/documents/tenants/$(tenantId)/vagas/$(string(request.resource.data.vaga))).data.uid == uid
      );
    }

    // A empresa existe e não foi desativada pelo Super Admin.
    // (empresa sem o campo "ativo" = criada antes desse recurso = ativa)
    function empresaAtiva(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('ativo', true) != false;
    }

    // Sou membro dessa empresa e ela está ativa.
    // Conta bloqueada por 5 senhas erradas seguidas (só o Super Admin desbloqueia)
    function contaLivre() {
      return request.auth.token.email == null ||
        !exists(/databases/$(database)/documents/tentativas_login/$(request.auth.token.email)) ||
        get(/databases/$(database)/documents/tentativas_login/$(request.auth.token.email)).data.falhas < 5;
    }

    function souMembroAtivo(tenantId) {
      return estaLogado() && meuTenantId() != null && meuTenantId() == tenantId && meuRole() != 'Cliente' && empresaAtiva(tenantId) && contaLivre();
    }

    // documento de configuração de IA sem chave nenhuma (campo "chaves" ausente ou vazio)
    function iaDocSemChaves(d) {
      return !(d.get('valor', null) is map) || d.valor.get('chaves', {}) == {} || d.valor.get('chaves', null) == null;
    }

    // ---------- Investimentos (Etapa 05) ----------
    // O módulo é ligado empresa por empresa pelo Super Admin (tenants/{id}.modulos.investimentos — só ele grava
    // o documento da empresa). Quem usa: Diretor e Financeiro; o Administrativo só com a liberação do Diretor
    // (tenants/{id}/inv_acesso/{uid}). O Super Admin NÃO tem acesso automático aos dados privados (D-02).
    function invModulo(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('modulos', {}).get('investimentos', false) == true;
    }
    function invPodeUsar(tenantId) {
      return souMembroAtivo(tenantId) && invModulo(tenantId) && (
        ehRoleDiretor(meuRole()) || meuRole() == 'Financeiro' ||
        (meuRole() == 'Administrativo' && exists(/databases/$(database)/documents/tenants/$(tenantId)/inv_acesso/$(request.auth.uid))));
    }
    // soma de consumo: só os 3 contadores + horário do servidor; cada gravação soma de 0 a 500 em cada um
    function invSoma(campo) {
      return request.resource.data.get(campo, 0) is int &&
        request.resource.data.get(campo, 0) - (resource == null ? 0 : resource.data.get(campo, 0)) >= 0 &&
        request.resource.data.get(campo, 0) - (resource == null ? 0 : resource.data.get(campo, 0)) <= 500;
    }
    // ---------- Investimentos (Etapas 06–08) ----------
    // Carteira PESSOAL: só o dono (nem o Diretor, nem o Super Admin). Carteira da EMPRESA: Diretor e Financeiro.
    // (escrita para gastar poucas expressões: o Firebase avalia no máximo 1.000 por gravação)
    function invCartPode(tenantId, d) {
      return d.tipo == 'pessoal' ? (d.dono == request.auth.uid && (meuRole() == 'SuperAdmin' ? invSaPropria(tenantId) : invPodeUsar(tenantId))) :
        (d.tipo == 'empresa' && (ehRoleDiretor(meuRole()) || meuRole() == 'Financeiro') && invPodeUsar(tenantId));
    }
    // D-02 (aprovada em 26/11/2026): o Super Admin pode ter a PRÓPRIA carteira pessoal, só na empresa a que está vinculado,
    // com o módulo ligado nela. Nunca lê carteira de outra pessoa (o dono tem que ser ele) nem a carteira da empresa.
    function invSaPropria(tenantId) {
      return estaLogado() && meuRole() == 'SuperAdmin' && meuTenantId() != null && meuTenantId() == tenantId &&
        empresaAtiva(tenantId) && contaLivre() && invModulo(tenantId);
    }
    // Etapa 10: a carteira guarda o SALDO (caixa em centavos e a quantidade de cada ativo em 1e-8) e a data da última
    // operação. As regras conferem cada mudança desse saldo: nada fica negativo, nem por gravação direta.
    function invCartCampos(d) {
      return d.keys().hasOnly(['nome', 'tipo', 'dono', 'corretoras', 'moedaBase', 'caixaAutomatico', 'ativa', 'opsN', 'saldo', 'ultimaData', 'criadoEm', 'atualizadoEm']) &&
        d.nome is string && d.nome.size() >= 1 && d.nome.size() <= 60 && d.tipo in ['pessoal', 'empresa'] && d.dono is string &&
        d.corretoras is list && d.corretoras.size() <= 20 && d.moedaBase == 'BRL' && d.caixaAutomatico is bool && d.ativa is bool &&
        d.opsN is int && d.opsN >= 0 && d.opsN <= 5000 && d.atualizadoEm == request.time &&
        d.saldo is map && d.saldo.keys().hasOnly(['caixa', 'pos']) && d.saldo.caixa is int && d.saldo.caixa >= 0 && d.saldo.pos is map && d.saldo.pos.size() <= 500 &&
        d.ultimaData is string && d.ultimaData.size() == 10;
    }
    function invNum(d, campo, max) {
      return !d.keys().hasAny([campo]) || ((d[campo] is int || d[campo] is float) && d[campo] >= 0 && d[campo] <= max);
    }
    function invTxt(d, campo, max) {
      return !d.keys().hasAny([campo]) || (d[campo] is string && d[campo].size() <= max);
    }
    // data AAAA-MM-DD de CALENDÁRIO (mês 1–12, dia que existe no mês, 29/02 só em ano bissexto) e não depois de hoje.
    // "Hoje" é a data UTC do servidor: no Brasil (UTC−3) a data local nunca passa da data UTC, então não há folga.
    function invDiasNoMes(a, m) {
      return m == 2 ? ((a % 4 == 0 && (a % 100 != 0 || a % 400 == 0)) ? 29 : 28) : (m in [4, 6, 9, 11] ? 30 : 31);
    }
    function invDataValida(s) {
      return s is string && s.matches('^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$') &&
        int(s[5:7]) >= 1 && int(s[5:7]) <= 12 && int(s[8:10]) >= 1 && int(s[8:10]) <= invDiasNoMes(int(s[0:4]), int(s[5:7])) &&
        int(s[0:4]) * 10000 + int(s[5:7]) * 100 + int(s[8:10]) <= request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
    }
    function invTem(d, campos) { return d.keys().hasAll(campos); }
    function invCam(d) { return d.moeda == 'USD' ? d.cambio : 1; }
    // campos obrigatórios e proibidos por tipo de operação
    function invOpCamposDoTipo(d) {
      return (d.tipo in ['compra', 'venda'] && invTem(d, ['assetId', 'qtd', 'qtdE8', 'preco', 'dq']) && d.qtd > 0) ||
        (d.tipo in ['aporte', 'retirada', 'taxa'] && invTem(d, ['valor']) && d.valor > 0 && !d.keys().hasAny(['assetId', 'qtd', 'preco', 'dq', 'fator', 'estorna'])) ||
        (d.tipo in ['dividendo', 'jcp', 'rendimento', 'amortizacao'] && invTem(d, ['assetId', 'valor']) && d.valor > 0 && !d.keys().hasAny(['qtd', 'preco', 'fator', 'estorna'])) ||
        (d.tipo in ['desdobramento', 'grupamento'] && invTem(d, ['assetId', 'fator', 'dq']) && d.fator > 1 && !d.keys().hasAny(['valor', 'preco', 'estorna'])) ||
        (d.tipo == 'bonificacao' && invTem(d, ['assetId', 'qtd', 'qtdE8', 'dq']) && d.qtd > 0 && !d.keys().hasAny(['preco', 'fator', 'estorna'])) ||
        (d.tipo == 'estorno' && invTem(d, ['estorna', 'dc', 'ai']) && !d.keys().hasAny(['assetId', 'qtd', 'preco', 'valor', 'fator']));
    }
    // efeito declarado (dq = quantidade em 1e-8, dc = caixa em centavos, ai = aporte implícito) conferido com os números
    // da operação. Tolerância de 2 centavos / 1 unidade de 1e-8 (o cálculo da tela é exato; aqui a conta é em ponto flutuante).
    function invOpEfeito(d, posAntes) {
      return d.dc is int && d.ai is int && d.ai >= 0 && (!d.keys().hasAny(['dq']) || d.dq is int) && (
        (d.tipo == 'compra' && d.qtdE8 is int && math.abs(d.qtdE8 - d.qtd * 100000000) <= 1 && d.dq == d.qtdE8 && d.dc <= 0 &&
          math.abs(-d.dc - (d.qtd * d.preco + d.get('taxas', 0)) * invCam(d) * 100) <= 2) ||
        (d.tipo == 'venda' && d.qtdE8 is int && math.abs(d.qtdE8 - d.qtd * 100000000) <= 1 && d.dq == -d.qtdE8 && d.ai == 0 &&
          math.abs(d.dc - (d.qtd * d.preco - d.get('taxas', 0)) * invCam(d) * 100) <= 2) ||
        (d.tipo == 'aporte' && d.ai == 0 && d.dc > 0 && math.abs(d.dc - d.valor * 100) < 0.51) ||
        (d.tipo == 'retirada' && d.ai == 0 && d.dc < 0 && math.abs(-d.dc - d.valor * 100) < 0.51) ||
        (d.tipo == 'taxa' && d.dc < 0 && math.abs(-d.dc - d.valor * 100) < 0.51) ||
        (d.tipo in ['dividendo', 'jcp', 'rendimento'] && d.ai == 0 && !d.keys().hasAny(['dq']) && d.get('irRetido', 0) <= d.valor &&
          math.abs(d.dc - (d.valor - d.get('irRetido', 0)) * invCam(d) * 100) <= 2) ||
        (d.tipo == 'amortizacao' && d.ai == 0 && !d.keys().hasAny(['dq']) && math.abs(d.dc - d.valor * invCam(d) * 100) <= 2) ||
        (d.tipo == 'bonificacao' && d.ai == 0 && d.dc == 0 && d.qtdE8 is int && math.abs(d.qtdE8 - d.qtd * 100000000) <= 1 && d.dq == d.qtdE8) ||
        (d.tipo == 'desdobramento' && d.ai == 0 && d.dc == 0 && d.dq >= 0 && math.abs((posAntes + d.dq) - posAntes * d.fator) <= d.fator) ||
        (d.tipo == 'grupamento' && d.ai == 0 && d.dc == 0 && d.dq <= 0 && math.abs((posAntes + d.dq) - posAntes / d.fator) <= 1));
    }
    // operação: imutável (só criar); corrigir = nova operação "estorno"
    // Auditoria (26/11/2026): quantidade e preço até 10 milhões (o cálculo usa inteiros em 1e-8 e precisa caber em 2^53)
    function invOpValida(d) {
      return d.keys().hasOnly(['tipo', 'data', 'assetId', 'qtd', 'qtdE8', 'preco', 'valor', 'taxas', 'irRetido', 'fator', 'moeda', 'cambio', 'estorna', 'corretora', 'nota', 'seq', 'dq', 'dc', 'ai', 'alvoAsset', 'criadoPor', 'criadoEm']) &&
        d.tipo in ['compra', 'venda', 'aporte', 'retirada', 'dividendo', 'jcp', 'rendimento', 'taxa', 'desdobramento', 'grupamento', 'bonificacao', 'amortizacao', 'estorno'] &&
        invDataValida(d.data) && invOpCamposDoTipo(d) && (d.moeda != 'USD' || (d.keys().hasAny(['cambio']) && d.cambio > 0)) &&
        (!d.keys().hasAny(['assetId']) || (d.assetId is string && d.assetId.size() <= 40 && d.assetId.matches('^[A-Z]+:[A-Z0-9-]+:[A-Z0-9.-]+$'))) &&
        invNum(d, 'qtd', 10000000) && invNum(d, 'preco', 10000000) && invNum(d, 'valor', 10000000000) && invNum(d, 'taxas', 10000000) &&
        invNum(d, 'irRetido', 10000000000) && invNum(d, 'fator', 1000) && invNum(d, 'cambio', 100) &&
        d.moeda in ['BRL', 'USD'] && invTxt(d, 'estorna', 40) && invTxt(d, 'corretora', 40) && invTxt(d, 'nota', 200) &&
        (d.tipo != 'estorno' || d.keys().hasAny(['estorna'])) &&
        d.criadoPor == request.auth.uid && d.criadoEm == request.time;
    }
    function invOpNova(tenantId, cid, oid, c) {
      return c.ativa == true && oid == string(c.opsN + 1) &&
        request.resource.data.seq == c.opsN + 1 && invOpValida(request.resource.data) &&
        request.resource.data.data >= c.ultimaData &&
        getAfter(/databases/$(database)/documents/tenants/$(tenantId)/inv_carteiras/$(cid)).data.opsN == c.opsN + 1 &&
        (request.resource.data.tipo == 'estorno' ? invEstornoValido(tenantId, cid, request.resource.data) :
          invOpEfeito(request.resource.data, c.saldo.pos.get(request.resource.data.get('assetId', '-'), 0)));
    }
    // estorno = lançamento de REVERSÃO: a operação alvo existe, é reversível, não é estorno e ainda não foi estornada
    // (o marcador nasce agora); o efeito é exatamente o contrário do efeito da operação alvo.
    function invEstornoValido(tenantId, cid, d) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId)/inv_carteiras/$(cid)/operacoes/$(d.estorna)) &&
        invEstornoEspelha(d, get(/databases/$(database)/documents/tenants/$(tenantId)/inv_carteiras/$(cid)/operacoes/$(d.estorna)).data) &&
        !exists(/databases/$(database)/documents/tenants/$(tenantId)/inv_carteiras/$(cid)/estornos/$(d.estorna)) &&
        existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/inv_carteiras/$(cid)/estornos/$(d.estorna));
    }
    function invEstornoEspelha(d, t) {
      return t.tipo in ['compra', 'venda', 'aporte', 'retirada', 'dividendo', 'jcp', 'rendimento', 'taxa', 'amortizacao', 'bonificacao'] &&
        d.dc is int && d.dc == -t.dc && d.ai == 0 &&
        (t.keys().hasAny(['dq']) ? (d.keys().hasAny(['dq']) && d.dq == -t.dq && d.alvoAsset == t.assetId) : !d.keys().hasAny(['dq']));
    }
    function invAtivoDaOp(o) { return o.tipo == 'estorno' ? o.get('alvoAsset', '-') : o.get('assetId', '-'); }
    function invSaldoTransicao(a, n, o) {
      return n.ultimaData == o.data && o.data >= a.ultimaData &&
        // caixa: antes + efeito + aporte implícito, nunca negativo; aporte implícito só cobre o que faltou (e só no modo automático)
        n.saldo.caixa == a.saldo.caixa + o.dc + o.ai && n.saldo.caixa >= 0 &&
        (o.ai == 0 || (a.caixaAutomatico == true && o.tipo in ['compra', 'taxa'] && a.saldo.caixa + o.dc < 0 && o.ai == -(a.saldo.caixa + o.dc))) &&
        // quantidade: só o ativo da operação muda, pelo efeito declarado, e nunca fica negativa
        (o.keys().hasAny(['dq']) ?
          (n.saldo.pos.diff(a.saldo.pos).affectedKeys().hasOnly([invAtivoDaOp(o)]) &&
            n.saldo.pos.get(invAtivoDaOp(o), 0) == a.saldo.pos.get(invAtivoDaOp(o), 0) + o.dq && n.saldo.pos.get(invAtivoDaOp(o), 0) >= 0) :
          n.saldo.pos == a.saldo.pos);
    }
    function invUsoValido() {
      return request.resource.data.keys().hasOnly(['leituras', 'gravacoes', 'exclusoes', 'atualizadoEm']) &&
        request.resource.data.atualizadoEm == request.time &&
        invSoma('leituras') && invSoma('gravacoes') && invSoma('exclusoes');
    }

    // ---------- usuarios/{uid} ----------
    match /usuarios/{userId} {
      // Cada um lê o próprio documento (é assim que o sistema descobre o
      // tenantId e o papel logo após o login). Colegas da mesma empresa
      // também (a tela de Usuários lista a equipe).
      allow read: if estaLogado() && (
        request.auth.uid == userId ||
        souSuperAdmin() ||
        (resource.data.get('tenantId', null) != null && meuTenantId() == resource.data.get('tenantId', null) && meuRole() != 'Cliente')
      );

      // Super Admin cria qualquer usuário. Diretor só cria na própria
      // empresa, num nível de empresa, numa vaga livre do limite e nunca
      // como titular (titular é definido só pelo Super Admin).
      allow create: if estaLogado() && (
        souSuperAdmin() ||
        (souDiretor() &&
          request.resource.data.tenantId == meuTenantId() &&
          empresaAtiva(meuTenantId()) &&
          roleNovo(request.resource.data.role) &&
          request.resource.data.get('titular', false) == false &&
          vagaValida(meuTenantId(), userId)) ||
        // login de cliente do portal: quem opera cria, sem vaga (não conta no limite)
        (podeOperar() &&
          request.resource.data.tenantId == meuTenantId() &&
          empresaAtiva(meuTenantId()) &&
          request.resource.data.role == 'Cliente' &&
          request.resource.data.clienteNome is string && request.resource.data.clienteNome.size() > 0 &&
          request.resource.data.get('titular', false) == false &&
          !('vaga' in request.resource.data))
      );

      allow update: if estaLogado() && (
        souSuperAdmin() ||
        // o próprio usuário: pode mudar o nome etc., NUNCA nível, empresa,
        // titularidade ou vaga
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'tenantId', 'titular', 'vaga', 'clienteNome'])) ||
        (podeOperar() && resource.data.role == 'Cliente' &&
          resource.data.tenantId == meuTenantId() && request.resource.data.tenantId == meuTenantId() &&
          request.resource.data.role == 'Cliente' && !('vaga' in request.resource.data)) ||
        // Diretor: só gente da própria empresa, que continua nela, num nível
        // de empresa — e nunca mexe no titular. A pessoa alterada também
        // precisa já ser da equipe: o Super Admin (mesmo vinculado à empresa)
        // e os logins de Cliente do portal ficam de fora.
        (souDiretor() &&
          roleDeEmpresa(resource.data.get('role', 'TenantUser')) &&
          resource.data.tenantId == meuTenantId() &&
          request.resource.data.tenantId == meuTenantId() &&
          resource.data.get('titular', false) == false &&
          roleNovo(request.resource.data.role) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['titular', 'vaga']))
      );

      // Remover acesso: Diretor da empresa, nunca o titular.
      allow delete: if estaLogado() && (
        souSuperAdmin() ||
        (souDiretor() &&
          resource.data.tenantId == meuTenantId() &&
          resource.data.get('titular', false) == false &&
          roleDeEmpresa(resource.data.role)) ||
        (podeOperar() && resource.data.tenantId == meuTenantId() && resource.data.role == 'Cliente')
      );
    }

    // ---------- tenants/{tenantId} ----------
    // Dados gerais da empresa (nome, plano, ativo). Membros LEEM (o app
    // precisa saber o plano); só o Super Admin GRAVA.
    match /tenants/{tenantId} {
      allow read: if estaLogado() && (souSuperAdmin() || meuTenantId() == tenantId);
      allow write: if souSuperAdmin();

      // ---------- tenants/{tenantId}/dados/{docId} ----------
      // TODOS os dados operacionais da empresa (clientes, produtos,
      // pedidos, financeiro, CRM, configurações...). Só membros de uma
      // empresa ATIVA (ou o Super Admin) leem e gravam.
      // Por nível: o financeiro (caixa, modelo, metas) só pra quem vê
      // financeiro; configurações da empresa só o Diretor grava; o resto
      // todos leem e só quem opera grava.
      match /dados/{docId} {
        // Chaves de IA (correção de segurança S1): o documento de IA que ainda tiver chaves de uma versão antiga
        // só é lido pelo Diretor (que o limpa ao abrir) e pelo Super Admin (backup); a equipe não lê até a limpeza.
        allow read: if souSuperAdmin() || (souMembroAtivo(tenantId) &&
          (!(docId in ['eagles_fin_ciclos_v1', 'eagles_fin_modelo_v1', 'eagles_fin_metas_v1', 'eagles_fin_caixas_v1', 'eagles_fin_tributos_v1', 'eagles_fin_pix_v1', 'eagles_fin_ia_analista_v1', 'eagles_fin_ia_analista_erp_v1']) || veFinanceiro()) &&
          (docId != 'eagles_ia_config_v1' || souDiretor() || resource == null || iaDocSemChaves(resource.data)));
        // e NINGUÉM grava chave de IA no banco (nem o Diretor, nem o Super Admin, nem uma restauração de backup antigo)
        allow write: if (docId != 'eagles_ia_config_v1' || request.resource == null || iaDocSemChaves(request.resource.data)) && (souSuperAdmin() || (souMembroAtivo(tenantId) && (
          (docId in ['eagles_fin_ciclos_v1', 'eagles_fin_modelo_v1', 'eagles_fin_metas_v1', 'eagles_fin_caixas_v1', 'eagles_fin_tributos_v1', 'eagles_fin_pix_v1', 'eagles_fin_ia_analista_v1', 'eagles_fin_ia_analista_erp_v1'] && veFinanceiro()) ||
          (docId in ['eagles_perfil_empresa_v1', 'eagles_cfg_portal_cliente_v1', 'eagles_cfg_briefing_visual_v1', 'eagles_cfg_categorias_conteudo_v1', 'eagles_crm_pagina_aprovacao_v1', 'eagles_integracao_pixels_v1', 'eagles_backup_meta_v1', 'eagles_ia_config_v1', 'eagles_sistema_config_v1'] && souDiretor()) ||
          (!(docId in ['eagles_fin_ciclos_v1', 'eagles_fin_modelo_v1', 'eagles_fin_metas_v1', 'eagles_fin_caixas_v1', 'eagles_fin_tributos_v1', 'eagles_fin_pix_v1', 'eagles_fin_ia_analista_v1', 'eagles_fin_ia_analista_erp_v1', 'eagles_perfil_empresa_v1', 'eagles_cfg_portal_cliente_v1', 'eagles_cfg_briefing_visual_v1', 'eagles_cfg_categorias_conteudo_v1', 'eagles_crm_pagina_aprovacao_v1', 'eagles_integracao_pixels_v1', 'eagles_backup_meta_v1', 'eagles_ia_config_v1', 'eagles_sistema_config_v1']) && podeOperar())
        )));
      }

      // Vagas do limite de usuários: o Diretor ocupa uma vaga junto com a
      // criação do usuário (mesmo lote) e libera junto com a remoção.
      match /vagas/{vagaId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId);
        allow create: if souSuperAdmin() || (
          souDiretor() && meuTenantId() == tenantId && empresaAtiva(tenantId) &&
          int(vagaId) >= 1 &&
          int(vagaId) <= get(/databases/$(database)/documents/tenants/$(tenantId)).data.limiteUsuarios &&
          request.resource.data.uid is string &&
          getAfter(/databases/$(database)/documents/usuarios/$(request.resource.data.uid)).data.tenantId == tenantId
        );
        allow update: if souSuperAdmin();
        allow delete: if souSuperAdmin() || (
          souDiretor() && meuTenantId() == tenantId &&
          !existsAfter(/databases/$(database)/documents/usuarios/$(resource.data.uid))
        );
      }

      // ---------- Financeiro (modelo novo) ----------
      // Um documento por lançamento / recorrência. Quem opera (ex.:
      // Administrativo fechando um negócio ou fazendo uma venda) pode
      // CRIAR; ler, editar e excluir é só de quem vê o financeiro.
      match /fin_lancamentos/{id} {
        allow read, update, delete: if souSuperAdmin() || (souMembroAtivo(tenantId) && veFinanceiro());
        allow create: if souSuperAdmin() || (souMembroAtivo(tenantId) && (veFinanceiro() || podeOperar()));
      }
      match /fin_recorrencias/{id} {
        allow read, update, delete: if souSuperAdmin() || (souMembroAtivo(tenantId) && veFinanceiro());
        allow create: if souSuperAdmin() || (souMembroAtivo(tenantId) && (veFinanceiro() || podeOperar()));
      }
      match /fin_meta/{id} {
        allow read, write: if souSuperAdmin() || (souMembroAtivo(tenantId) && veFinanceiro());
      }

      // Receitas lançadas por quem NÃO vê o financeiro (ex.: Administrativo
      // fechando um negócio). Ele só consegue CRIAR aqui — nunca ler o
      // caixa. Quem vê o financeiro move essas receitas pro mês certo.
      match /receitas_pendentes/{id} {
        allow create: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
        allow read, delete: if souSuperAdmin() || (souMembroAtivo(tenantId) && veFinanceiro());
      }

      // ---------- tenants/{tenantId}/kanban_tarefas/{tarefaId} ----------
      // Kanban do CRM: UMA tarefa por documento (pra equipe editar o
      // quadro ao mesmo tempo sem uma gravação apagar a outra). Mesma
      // proteção dos dados: só membros de empresa ativa (ou Super Admin).
      // Conteúdos (produção): um documento por conteúdo
      match /conteudos/{conteudoId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId) ||
          (souCliente(tenantId) && resource.data.cliente == meuClienteNome());
        allow write: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
        // cliente no portal: só responde (aprovar/ajustes) e marca como postado
        allow update: if souCliente(tenantId) && resource.data.cliente == meuClienteNome() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['portalResposta', 'portalComentario', 'portalRespondidoEm', 'portalPostadoEm', 'portalPendente']) &&
          request.resource.data.get('portalComentario', '') is string && request.resource.data.get('portalComentario', '').size() <= 1000;
      }

      // Agenda: um documento por compromisso
      match /agenda/{compromissoId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId);
        allow write: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
      }

      // Portal do Cliente: padrão da agência (_padrao) e ajustes de cada cliente
      match /portal/{docId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId) ||
          (souCliente(tenantId) && (docId == '_padrao' || resource.data.cliente == meuClienteNome()));
        allow write: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
      }

      // Pedidos do portal (ideias de post e serviços)
      match /portal_pedidos/{pedidoId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId) ||
          (souCliente(tenantId) && resource.data.cliente == meuClienteNome());
        allow create: if souCliente(tenantId) &&
          request.resource.data.keys().hasOnly(['cliente', 'tipo', 'titulo', 'texto', 'links', 'prazo', 'criadoEm', 'processado', 'autorUid']) &&
          request.resource.data.cliente == meuClienteNome() && request.resource.data.processado == false &&
          request.resource.data.autorUid == request.auth.uid &&
          request.resource.data.tipo in ['ideia', 'servico'] &&
          request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 100 &&
          request.resource.data.texto is string && request.resource.data.texto.size() <= 2000 &&
          request.resource.data.links is list && request.resource.data.links.size() <= 10;
        allow update, delete: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
        allow create: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar()); // restaurar backup
      }

      match /kanban_tarefas/{tarefaId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId);
        allow write: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
      }

      // Publicações agendadas no Instagram: a equipe cria e acompanha; quem
      // publica é o servidor. As chaves da Meta (meta_privado) não têm regra:
      // nenhum navegador lê ou grava.
      match /meta_agendados/{agId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId);
        allow write: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
      }

      // Cadastros do ERP e listas do CRM: um documento por item (antes era uma
      // lista inteira dentro de dados/{chave}; duas gravações juntas se apagavam).
      // v157: + anotações e contatos dos negócios (mesmas permissões das outras
      // listas do CRM: membros leem, só quem opera grava).
      match /{colecaoErp}/{itemId} {
        allow read: if (colecaoErp in ['erp_produtos', 'erp_pedidos_venda', 'erp_clientes_fornecedores', 'erp_contratos', 'erp_pedido_compras', 'erp_notas_entrada', 'erp_mov_estoque', 'erp_vendedores', 'erp_funcionarios', 'erp_objetos_postagem', 'erp_conferencia_estoque', 'crm_clientes', 'crm_negocios', 'crm_contratos', 'crm_servicos', 'crm_tarefas_dia', 'crm_lembretes', 'crm_negocio_anotacoes', 'crm_negocio_contatos']) &&
          (souSuperAdmin() || souMembroAtivo(tenantId));
        allow write: if (colecaoErp in ['erp_produtos', 'erp_pedidos_venda', 'erp_clientes_fornecedores', 'erp_contratos', 'erp_pedido_compras', 'erp_notas_entrada', 'erp_mov_estoque', 'erp_vendedores', 'erp_funcionarios', 'erp_objetos_postagem', 'erp_conferencia_estoque', 'crm_clientes', 'crm_negocios', 'crm_contratos', 'crm_servicos', 'crm_tarefas_dia', 'crm_lembretes', 'crm_negocio_anotacoes', 'crm_negocio_contatos']) &&
          (souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar()));
      }

      // ---------- Investimentos (Etapa 05) ----------
      // Favoritos: um documento por pessoa; só a própria pessoa lê e grava (nem o Diretor, nem o Super Admin).
      match /inv_favoritos/{uid} {
        allow read, delete: if request.auth != null && request.auth.uid == uid && invPodeUsar(tenantId);
        allow create, update: if request.auth != null && request.auth.uid == uid && invPodeUsar(tenantId) &&
          request.resource.data.keys().hasOnly(['listas', 'atualizadoEm']) &&
          request.resource.data.listas is list && request.resource.data.listas.size() >= 1 && request.resource.data.listas.size() <= 20 &&
          request.resource.data.atualizadoEm == request.time;
      }
      // Liberação do Administrativo: só o Diretor da empresa grava, e só para quem é Administrativo da própria empresa.
      match /inv_acesso/{uid} {
        allow read: if souMembroAtivo(tenantId) && (request.auth.uid == uid || souDiretor());
        allow create: if souMembroAtivo(tenantId) && souDiretor() && meuRole() != 'SuperAdmin' && invModulo(tenantId) &&
          get(/databases/$(database)/documents/usuarios/$(uid)).data.get('tenantId', '') == tenantId &&
          get(/databases/$(database)/documents/usuarios/$(uid)).data.get('role', '') == 'Administrativo' &&
          request.resource.data.keys().hasOnly(['liberadoPor', 'em']) &&
          request.resource.data.liberadoPor == request.auth.uid && request.resource.data.em == request.time;
        allow delete: if souMembroAtivo(tenantId) && souDiretor() && meuRole() != 'SuperAdmin';
      }

      // Carteiras (Etapa 07). Nada é apagado: a carteira é arquivada (ativa = false) e a operação é estornada.
      match /inv_carteiras/{cid} {
        allow read: if invCartPode(tenantId, resource.data);
        allow create: if invCartCampos(request.resource.data) && request.resource.data.dono == request.auth.uid &&
          request.resource.data.opsN == 0 && request.resource.data.saldo == { 'caixa': 0, 'pos': {} } && request.resource.data.ultimaData == '1900-01-01' &&
          request.resource.data.criadoEm == request.time && invCartPode(tenantId, request.resource.data);
        // O contador só sobe junto com a operação de número igual ao novo contador (nunca sozinho) e só com a carteira ativa;
        // o saldo muda EXATAMENTE pelo efeito dessa operação e nunca fica negativo (caixa nem quantidade de nenhum ativo);
        // a data da operação não pode ser anterior à da última (lançamentos em ordem de data).
        allow update: if invCartPode(tenantId, resource.data) && invCartCampos(request.resource.data) &&
          request.resource.data.tipo == resource.data.tipo && request.resource.data.dono == resource.data.dono &&
          request.resource.data.criadoEm == resource.data.criadoEm && request.resource.data.caixaAutomatico == resource.data.caixaAutomatico && (
            (request.resource.data.opsN == resource.data.opsN && request.resource.data.saldo == resource.data.saldo && request.resource.data.ultimaData == resource.data.ultimaData) ||
            (request.resource.data.opsN == resource.data.opsN + 1 && resource.data.ativa == true && request.resource.data.ativa == true &&
              invSaldoTransicao(resource.data, request.resource.data,
                getAfter(/databases/$(database)/documents/tenants/$(tenantId)/inv_carteiras/$(cid)/operacoes/$(string(request.resource.data.opsN))).data)));
        allow delete: if false;
        // Operações NUMERADAS: a de número N só existe se o contador passar de N−1 para N na mesma gravação.
        // Assim cada incremento corresponde a exatamente UMA operação, e duas gravações simultâneas na mesma
        // posição não passam juntas (a segunda encontra o número ocupado e é recusada).
        match /operacoes/{oid} {
          allow read: if invCartPode(tenantId, get(/databases/$(database)/documents/tenants/$(tenantId)/inv_carteiras/$(cid)).data);
          allow create: if invOpNova(tenantId, cid, oid, get(/databases/$(database)/documents/tenants/$(tenantId)/inv_carteiras/$(cid)).data);
          allow update, delete: if false;
        }
        // Marcador de estorno: um por operação estornada (impede estornar duas vezes); criado junto com o estorno.
        match /estornos/{alvo} {
          allow read: if invCartPode(tenantId, get(/databases/$(database)/documents/tenants/$(tenantId)/inv_carteiras/$(cid)).data);
          // (permissão garantida pela operação de estorno da mesma gravação, que só existe se a carteira passou pelas regras)
          allow create: if estaLogado() &&
            request.resource.data.keys().hasOnly(['op', 'criadoPor', 'criadoEm']) && request.resource.data.op is string &&
            request.resource.data.criadoPor == request.auth.uid && request.resource.data.criadoEm == request.time &&
            getAfter(/databases/$(database)/documents/tenants/$(tenantId)/inv_carteiras/$(cid)/operacoes/$(request.resource.data.op)).data.tipo == 'estorno' &&
            getAfter(/databases/$(database)/documents/tenants/$(tenantId)/inv_carteiras/$(cid)/operacoes/$(request.resource.data.op)).data.estorna == alvo;
          allow update, delete: if false;
        }
      }
      // Preços informados pela empresa (um documento só): todos do módulo leem; Diretor e Financeiro gravam.
      match /inv_precos/{docId} {
        allow read: if invPodeUsar(tenantId) || invSaPropria(tenantId);
        allow create, update: if docId == 'manual' && invPodeUsar(tenantId) && (ehRoleDiretor(meuRole()) || meuRole() == 'Financeiro') &&
          request.resource.data.keys().hasOnly(['itens', 'por', 'atualizadoEm']) && request.resource.data.itens is list &&
          request.resource.data.itens.size() <= 300 && request.resource.data.por == request.auth.uid && request.resource.data.atualizadoEm == request.time;
        allow delete: if false;
      }
      // Cenários de projeção (Etapa 09): um documento por pessoa, até 20 cenários; só ela lê e grava. Guarda só premissas.
      match /inv_cenarios/{uid} {
        allow read, delete: if request.auth != null && request.auth.uid == uid && (invPodeUsar(tenantId) || invSaPropria(tenantId));
        allow create, update: if request.auth != null && request.auth.uid == uid && (invPodeUsar(tenantId) || invSaPropria(tenantId)) &&
          request.resource.data.keys().hasOnly(['itens', 'atualizadoEm']) && request.resource.data.itens is list &&
          request.resource.data.itens.size() <= 20 && request.resource.data.atualizadoEm == request.time;
      }
      // Alertas de preço: um documento por pessoa; só ela lê e grava.
      match /inv_alertas/{uid} {
        allow read, delete: if request.auth != null && request.auth.uid == uid && invPodeUsar(tenantId);
        allow create, update: if request.auth != null && request.auth.uid == uid && invPodeUsar(tenantId) &&
          request.resource.data.keys().hasOnly(['itens', 'atualizadoEm']) && request.resource.data.itens is list &&
          request.resource.data.itens.size() <= 50 && request.resource.data.atualizadoEm == request.time;
      }

      // Projetos do Kanban: também um documento por projeto.
      match /kanban_projetos/{projetoId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId);
        allow write: if souSuperAdmin() || (souMembroAtivo(tenantId) && podeOperar());
      }

      // Atendimento → Automações (modo assistido): um documento por mensagem
      // enviada ou pulada pela equipe. O id é fixo por envio, então duas
      // pessoas marcando a mesma mensagem não criam registro repetido.
      // O nível Financeiro também registra (ele envia as cobranças).
      match /atend_envios/{envioId} {
        allow read: if souSuperAdmin() || souMembroAtivo(tenantId);
        allow create, update: if souSuperAdmin() || (souMembroAtivo(tenantId) && (podeOperar() || veFinanceiro()) &&
          request.resource.data.keys().hasOnly(['chave', 'automacaoId', 'gatilho', 'nomeAutomacao', 'para', 'telefone', 'texto', 'status', 'por', 'uid', 'em', 'refTipo', 'refId']) &&
          request.resource.data.status in ['enviado', 'ignorado'] &&
          request.resource.data.texto is string && request.resource.data.texto.size() <= 4000);
        allow delete: if souSuperAdmin() || (souMembroAtivo(tenantId) && (podeOperar() || veFinanceiro()));
      }
    }

    // ---------- propostas_publicas/{propostaId} ----------
    // Exceção controlada: o cliente final abre a proposta por um link,
    // sem login.
    // - "get" (abrir UM documento pelo id do link): público, desde que não
    //   seja rascunho.
    // - "list" (consultar a coleção): só o dono, filtrando pela própria
    //   empresa. Sem isso, qualquer um listaria propostas de todo mundo.
    // - Quem não é dono só consegue marcar como visualizada, aprovar (com
    //   assinatura) ou recusar — nenhum outro campo.
    match /propostas_publicas/{propostaId} {
      allow get: if resource.data.status != 'rascunho' ||
        (estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId()));

      allow list: if estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId());

      allow create: if estaLogado() && request.resource.data.tenantId == meuTenantId() && empresaAtiva(meuTenantId()) && podeOperar();

      allow update: if
        (estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()))) ||
        (
          resource.data.status == 'enviada' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assinatura', 'atualizadoEm', 'visualizadoEm']) &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visualizadoEm']) ||
            request.resource.data.status == 'aprovada' ||
            request.resource.data.status == 'recusada'
          )
        );

      allow delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
    }

    // ---------- paginas_publicas/{endereco} ----------
    // Site da empresa (Página Pública). Mesma lógica dos planos: o visitante
    // lê UM documento pelo endereço (se ativo); o endereço é o id, então
    // duas empresas nunca usam o mesmo.
    match /paginas_publicas/{endereco} {
      allow get: if resource.data.ativa == true ||
        (estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId()));
      allow list: if estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId());
      allow create: if estaLogado() && request.resource.data.tenantId == meuTenantId() && empresaAtiva(meuTenantId()) && podeOperar();
      allow update: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && (podeOperar() || souDiretor()))) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
    }

    // ---------- leads_publicos/{id} ----------
    // Formulário de contato do site: o VISITANTE (sem login) só consegue
    // criar, com campos limitados, e só pra uma página publicada e ativa
    // daquela empresa. Quem opera no CRM lê e apaga (vira cliente + negócio).
    match /leads_publicos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tenantId', 'pagina', 'nome', 'email', 'telefone', 'mensagem', 'servicos', 'criadoEm']) &&
        request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 100 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 120 &&
        request.resource.data.telefone is string && request.resource.data.telefone.size() <= 30 &&
        request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 1000 &&
        request.resource.data.servicos is list && request.resource.data.servicos.size() <= 20 &&
        request.resource.data.pagina is string &&
        exists(/databases/$(database)/documents/paginas_publicas/$(request.resource.data.pagina)) &&
        get(/databases/$(database)/documents/paginas_publicas/$(request.resource.data.pagina)).data.ativa == true &&
        get(/databases/$(database)/documents/paginas_publicas/$(request.resource.data.pagina)).data.tenantId == request.resource.data.tenantId;
      allow read, delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
      allow update: if false;
    }

    // ---------- agendamentos_publicos/{id} ----------
    // Página de agendamento online: o visitante (sem login) só cria um
    // pedido de horário para uma página de agendamento publicada e ativa
    // daquela empresa. A equipe lê, transforma em compromisso e apaga.
    match /agendamentos_publicos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tenantId', 'pagina', 'nome', 'telefone', 'email', 'servico', 'observacao', 'data', 'hora', 'duracao', 'criadoEm']) &&
        request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 100 &&
        request.resource.data.telefone is string && request.resource.data.telefone.size() > 0 && request.resource.data.telefone.size() <= 30 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 120 &&
        request.resource.data.servico is string && request.resource.data.servico.size() <= 80 &&
        request.resource.data.observacao is string && request.resource.data.observacao.size() <= 300 &&
        request.resource.data.data is string && request.resource.data.data.size() == 10 &&
        request.resource.data.hora is string && request.resource.data.hora.size() == 5 &&
        request.resource.data.duracao is number && request.resource.data.duracao > 0 && request.resource.data.duracao <= 480 &&
        request.resource.data.pagina is string &&
        exists(/databases/$(database)/documents/paginas_publicas/$(request.resource.data.pagina)) &&
        get(/databases/$(database)/documents/paginas_publicas/$(request.resource.data.pagina)).data.ativa == true &&
        get(/databases/$(database)/documents/paginas_publicas/$(request.resource.data.pagina)).data.tipo == 'agenda' &&
        get(/databases/$(database)/documents/paginas_publicas/$(request.resource.data.pagina)).data.tenantId == request.resource.data.tenantId;
      allow read, delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
      allow update: if false;
    }

    // ---------- tentativas_login/{email} ----------
    // Conta as senhas erradas seguidas de cada e-mail. Quem está na tela de
    // login (sem estar logado) só pode SOMAR 1; ninguém zera nem lê de fora.
    // Com 5, a conta fica bloqueada (regra contaLivre) até o Super Admin
    // apagar o registro. Acertar a senha antes de 5 zera o contador.
    // ---------- Investimentos: consumo do dia (soma cooperativa; sem dados privados) ----------
    // Lê e soma: quem usa o módulo (em qualquer empresa habilitada) e o Super Admin. Ninguém apaga nem diminui.
    match /inv_admin_uso/{dia} {
      allow read: if souSuperAdmin() || (meuTenantId() != null && invPodeUsar(meuTenantId()));
      allow create, update: if dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        (souSuperAdmin() || (meuTenantId() != null && invPodeUsar(meuTenantId()))) && invUsoValido();
    }

    // ---------- Investimentos: cache GLOBAL de mercado (um por ativo, para todas as empresas) ----------
    // Só o SERVIDOR grava (D-10). Ninguém do navegador grava: dado de mercado nunca é repetido por empresa.
    match /inv_mercado/{ativoId} {
      allow read: if souSuperAdmin() || (meuTenantId() != null && invPodeUsar(meuTenantId()));
      allow write: if false;
    }

    match /tentativas_login/{email} {
      allow get: if souSuperAdmin() || (estaLogado() && request.auth.token.email == email);
      allow list: if souSuperAdmin();
      allow create: if email.size() <= 200 && request.resource.data.keys().hasOnly(['falhas', 'ultimaEm']) &&
        request.resource.data.falhas == 1 && request.resource.data.ultimaEm == request.time;
      allow update: if request.resource.data.keys().hasOnly(['falhas', 'ultimaEm']) &&
        request.resource.data.falhas == resource.data.falhas + 1 && request.resource.data.ultimaEm == request.time;
      allow delete: if souSuperAdmin() || (estaLogado() && request.auth.token.email == email && resource.data.falhas < 5);
    }

    // ---------- erros_app/{id} ----------
    // Erros técnicos do sistema, enviados pelo aparelho de quem está logado
    // (só a mensagem, a tela e a versão). Só o Super Admin lê e apaga.
    match /erros_app/{id} {
      allow create: if estaLogado() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['tenantId', 'uid', 'usuario', 'pagina', 'mensagem', 'pilha', 'tipo', 'navegador', 'tela', 'versao', 'assinatura', 'em']) &&
        request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 300 &&
        request.resource.data.pilha is string && request.resource.data.pilha.size() <= 1500 &&
        request.resource.data.navegador is string && request.resource.data.navegador.size() <= 200 &&
        request.resource.data.pagina is string && request.resource.data.pagina.size() <= 120;
      allow read, delete: if souSuperAdmin();
      allow update: if false;
    }

    // ---------- eagles/{chave} (dados de antes das empresas separadas) ----------
    // Só o Super Admin lê, pra ferramenta de importar dados antigos. Ninguém grava.
    match /eagles/{chave} {
      allow read: if souSuperAdmin();
      allow write: if false;
    }

    // ---------- conteudos_publicos/{codigo} ----------
    // Link de aprovação de um conteúdo: o cliente (sem login) lê UM
    // documento pelo código e responde UMA vez — só os campos da resposta.
    match /conteudos_publicos/{codigo} {
      allow get: if true;
      allow list: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
      allow create: if estaLogado() && request.resource.data.tenantId == meuTenantId() && empresaAtiva(meuTenantId()) && podeOperar();
      allow update: if
        (estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar())) && request.resource.data.tenantId == resource.data.tenantId) ||
        (resource.data.resposta == '' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resposta', 'comentario', 'respondidoEm']) &&
          request.resource.data.resposta in ['aprovado', 'ajustes'] &&
          request.resource.data.comentario is string && request.resource.data.comentario.size() <= 1000) ||
        // depois de aprovar, o cliente pode marcar que já postou (pelo portal)
        (resource.data.resposta == 'aprovado' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['postadoEm']) &&
          request.resource.data.postadoEm is string && request.resource.data.postadoEm.size() <= 40);
      allow delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
    }

    // ---------- portais_publicos/{token} ----------
    // Portal do cliente SEM login: a equipe publica aqui um retrato dos
    // conteúdos daquele cliente. Quem tem o link (token longo e aleatório)
    // lê UM documento; ninguém lista. As respostas do cliente não passam
    // por aqui: vão para conteudos_publicos (aprovação) e
    // portal_pedidos_publicos (ideias e serviços).
    match /portais_publicos/{token} {
      allow get: if true;
      allow list: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
      allow create: if estaLogado() && request.resource.data.tenantId == meuTenantId() && empresaAtiva(meuTenantId()) && podeOperar();
      allow update: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar())) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
    }

    // ---------- portal_pedidos_publicos/{pedidoId} ----------
    // Ideias e pedidos de serviço mandados pelo portal sem login. Só cria
    // quem tem um link de portal válido, e só para o cliente daquele link.
    match /portal_pedidos_publicos/{pedidoId} {
      allow create: if
        request.resource.data.keys().hasOnly(['tenantId', 'cliente', 'portalToken', 'tipo', 'titulo', 'texto', 'links', 'prazo', 'criadoEm', 'processado']) &&
        request.resource.data.portalToken is string && request.resource.data.portalToken.size() > 10 && request.resource.data.portalToken.size() < 80 &&
        exists(/databases/$(database)/documents/portais_publicos/$(request.resource.data.portalToken)) &&
        get(/databases/$(database)/documents/portais_publicos/$(request.resource.data.portalToken)).data.tenantId == request.resource.data.tenantId &&
        get(/databases/$(database)/documents/portais_publicos/$(request.resource.data.portalToken)).data.cliente == request.resource.data.cliente &&
        request.resource.data.processado == false &&
        request.resource.data.tipo in ['ideia', 'servico'] &&
        request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 100 &&
        request.resource.data.texto is string && request.resource.data.texto.size() <= 2000 &&
        request.resource.data.links is list && request.resource.data.links.size() <= 10 &&
        request.resource.data.prazo is string && request.resource.data.prazo.size() <= 10 &&
        request.resource.data.criadoEm is string && request.resource.data.criadoEm.size() <= 40;
      allow get: if false;
      allow list: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
      allow update, delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
    }

    // ---------- pix_publico/{tenantId} ----------
    // Dados do PIX que o cliente vê na página do orçamento aprovado (chave,
    // nome e cidade — que vão de todo jeito no QR Code). Qualquer um lê
    // UM documento pelo id; só quem vê o financeiro da empresa grava.
    match /pix_publico/{tenantId} {
      allow get: if true;
      allow list: if false;
      allow write: if souSuperAdmin() || (estaLogado() && meuTenantId() == tenantId && empresaAtiva(tenantId) && veFinanceiro());
    }

    // ---------- planos_publicos/{endereco} ----------
    // Apresentação pública de planos: o visitante abre UM documento pelo
    // endereço (só se a página estiver ativa). O id do documento É o
    // endereço, então duas empresas nunca usam o mesmo: a segunda não
    // consegue gravar por cima (o documento já tem dono).
    match /planos_publicos/{endereco} {
      allow get: if resource.data.ativa == true ||
        (estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId()));
      allow list: if estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId());
      allow create: if estaLogado() && request.resource.data.tenantId == meuTenantId() && empresaAtiva(meuTenantId()) && podeOperar();
      allow update: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar())) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
    }

    // ---------- briefings_publicos/{briefingId} ----------
    // Mesma lógica: o cliente final preenche pelo link, sem login.
    // - "get": público (quem tem o link abre).
    // - "list": só o dono, filtrando pela própria empresa.
    // - Quem não é dono só responde, e só enquanto está "pendente".
    match /briefings_publicos/{briefingId} {
      allow get: if true;

      allow list: if estaLogado() && (souSuperAdmin() || resource.data.tenantId == meuTenantId());

      allow create: if estaLogado() && request.resource.data.tenantId == meuTenantId() && empresaAtiva(meuTenantId()) && podeOperar();

      allow update: if
        (estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()))) ||
        (
          resource.data.status == 'pendente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respostas', 'respondidoEm']) &&
          request.resource.data.status == 'respondido'
        );

      allow delete: if estaLogado() && (souSuperAdmin() || (resource.data.tenantId == meuTenantId() && podeOperar()));
    }
  }
}
