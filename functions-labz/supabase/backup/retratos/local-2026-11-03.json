    "restricoes": [
      {
        "tabela": "acionamentos",
        "nome": "acionamentos_id",
        "tipo": "c",
        "definicao": "CHECK ((id ~ '^acn_[0-9a-f]{32}$'::text))"
      },
      {
        "tabela": "acionamentos",
        "nome": "acionamentos_motivo",
        "tipo": "c",
        "definicao": "CHECK ((motivo = ANY (ARRAY['cron'::text, 'fila'::text, 'manual'::text])))"
      },
      {
        "tabela": "acionamentos",
        "nome": "acionamentos_pkey",
